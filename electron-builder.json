{
  "appId": "com.deepblue.photobooth",
  "productName": "Deep Blue Photobooth",
  "asar": true,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "directories": {
    "output": "release"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "DeepBluePhotobooth-Setup-${version}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "rexzai1992",
      "repo": "Photobooth-2fast.xyz",
      "releaseType": "release"
    }
  ]
}
