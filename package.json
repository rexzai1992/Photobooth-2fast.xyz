{
  "name": "deep-blue-photobooth",
  "description": "Deep Blue Photobooth web app with Windows kiosk wrapper",
  "author": "Deep Blue",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "desktop:build": "npm run build && electron-builder --config electron-builder.json --win nsis --x64",
    "desktop:build:dir": "npm run build && electron-builder --config electron-builder.json --win --dir --x64"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@supabase/supabase-js": "^2.90.1",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "wait-on": "^9.0.5",
    "wrangler": "^4.85.0"
  }
}
